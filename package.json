{
  "name": "locations-network",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "npm run build && NODE_ENV=development tsx server/index.ts",
    "build": "tsc -b && vite build && node scripts/precompress.mjs",
    "typecheck": "tsc -b --pretty false",
    "lint": "oxlint",
    "start": "node dist-server/index.js",
    "preview": "node dist-server/index.js",
    "test:server": "tsx --test server/**/*.test.ts",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "cesium": "^1.145.0",
    "compression": "^1.8.2",
    "dotenv": "^18.0.5",
    "express": "^5.2.1",
    "gsap": "^3.15.0",
    "leaflet": "^1.9.4",
    "lucide-react": "^1.48.0",
    "pdf-lib": "^1.17.1",
    "pg": "^8.23.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-leaflet": "^5.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/compression": "^1.8.1",
    "@types/express": "^5.0.6",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^24.13.3",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@types/supertest": "^7.2.1",
    "@vitejs/plugin-react": "^6.1.1",
    "oxlint": "^1.81.0",
    "supertest": "^7.3.0",
    "topojson-client": "^3.1.0",
    "tsx": "^4.23.15",
    "typescript": "~6.0.2",
    "us-atlas": "^3.0.1",
    "vite": "^8.3.0",
    "vite-plugin-static-copy": "^4.1.1",
    "wawoff2": "^2.0.1",
    "webgl-memory": "^1.1.3"
  }
}
