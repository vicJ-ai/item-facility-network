{
  "name": "locations-network",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && node scripts/precompress.mjs",
    "typecheck": "tsc -b --pretty false",
    "lint": "oxlint",
    "preview": "vite preview",
    "narration": "npm install --prefix scripts/narration --no-audit --no-fund --silent && node scripts/narration/generate.mjs",
    "narration:check": "node scripts/narration/generate.mjs --check",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "cesium": "^1.145.0",
    "gsap": "^3.15.0",
    "leaflet": "^1.9.4",
    "lucide-react": "^1.48.0",
    "pdf-lib": "^1.17.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-leaflet": "^5.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "oxlint": "^1.81.0",
    "topojson-client": "^3.1.0",
    "typescript": "~6.0.2",
    "us-atlas": "^3.0.1",
    "vite": "^8.3.0",
    "vite-plugin-static-copy": "^4.1.1",
    "wawoff2": "^2.0.1",
    "webgl-memory": "^1.1.3"
  }
}
